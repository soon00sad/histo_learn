# HistoVision backend image. libopenslide0 gives the API container real WSI
# support even on hosts (e.g. Windows dev machines) where the OpenSlide
# native library isn't installable via pip — see src/wsi/reader.py.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenslide0 \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config ./config
COPY src ./src
COPY scripts ./scripts

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

# models/ and data/ are mounted as volumes (see docker-compose.yml) — never
# baked into the image, so weights and patient data stay out of any registry.
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
